# Copy this file to .env and fill in your real values.
# .env is gitignored so your secrets never get committed.
# config.py reads every variable below via os.getenv().

# --- Destination database (where the Fivetran Platform Connector lands) ---
# Swap this one line for any PostgreSQL destination. Neon shape shown.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- Fivetran REST API (for pausing connectors) ---
# API key + secret form the HTTP Basic auth pair. Create them in the Fivetran
# dashboard under Account Settings.
FIVETRAN_API_KEY=your_fivetran_api_key
FIVETRAN_API_SECRET=your_fivetran_api_secret
FIVETRAN_ACCOUNT_ID=your_fivetran_account_id

# --- Slack trigger ---
SLACK_WEBHOOK_URL=

# --- Email trigger (SMTP) ---
# For Gmail/Workspace use an App Password, not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDR=
# Comma-separated list of recipients.
SMTP_TO_ADDRS=

# --- Custom webhook trigger ---
CUSTOM_WEBHOOK_URL=
# Sent as the Authorization header; leave blank if the endpoint is open.
CUSTOM_WEBHOOK_AUTH_HEADER=
